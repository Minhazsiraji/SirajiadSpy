generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") directUrl = env("DIRECT_URL") }

model Ad {
  id           String   @id @default(cuid())
  externalId   String?  @unique
  pageName     String
  pageId       String?
  adText       String?  @db.Text
  headline     String?
  cta          String?
  creativeUrl  String?  @db.Text
  creativeType String
  thumbnailUrl String?
  landingUrl   String?
  country      String   @default("BD")
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  daysActive   Int      @default(0)
  isActive     Boolean  @default(true)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  signalScore  Int      @default(0)
  evidence     Json?
  aiAnalysis   Json?
  landingAnalysis Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([signalScore])
  @@index([daysActive])
  @@index([country])
}

model TikTokAd {
  id           String   @id @default(cuid())
  keyword      String
  username     String
  caption      String   @db.Text
  videoUrl     String   @db.Text
  thumbnailUrl String?
  likes        Int      @default(0)
  views        Int      @default(0)
  duration     Int      @default(0)
  musicName    String?
  videoId      String?
  country      String   @default("BD")
  profitScore  Int      @default(0)
  firstSeen    DateTime @default(now())
  createdAt    DateTime @default(now())
  @@index([keyword])
  @@index([profitScore])
}
